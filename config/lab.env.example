# IndustrialMind lab configuration (template).
#
# Copy this file to  config/lab.env  and fill in the real values.
#   macOS/Linux:  cp config/lab.env.example config/lab.env
#   Windows:      Copy-Item config\lab.env.example config\lab.env
#
# config/lab.env is git-ignored on purpose: it holds the shared secret and the
# laptop addresses. Never commit it. The launcher scripts (scripts/run.sh and
# scripts/run.ps1) read this file and set the right environment variables for
# each role, so you do not export anything by hand.
#
# Fill every value below. Leave a value blank only if you are running
# everything on ONE laptop (single-machine rehearsal), in which case the
# launcher falls back to loopback automatically.
#
# Find a laptop's address:
#   macOS:    ipconfig getifaddr en0        (try en1 if blank)
#   Windows:  ipconfig   -> read "IPv4 Address" under your Wi-Fi/Ethernet adapter

# --- the four laptops -------------------------------------------------------
MW_IP=            # Mac A  : middleware + dashboard
PLC_IP=           # Windows A : PLC digital twin
SCADA_IP=         # Mac B  : SCADA operator
ATTACKER_IP=      # Windows B : attacker

# --- the shared HMAC secret -------------------------------------------------
# One random string of 32+ characters, IDENTICAL on Mac A, Mac B and Windows B.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(24))"
HMAC_SECRET=

# --- optional --------------------------------------------------------------
# Open the dashboard to other laptops (default: loopback only, on Mac A).
# Set to 0.0.0.0 only if another laptop must open the dashboard in a browser.
DASHBOARD_BIND_HOST=127.0.0.1
